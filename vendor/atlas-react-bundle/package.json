{
  "name": "@diligentcorp/atlas-react-bundle",
  "version": "0.0.1",
  "type": "module",
  "description": "A bundle of all Atlas React packages for AI prototyping. VENDORED: pre-built dist/ committed to pin the design system. devDependencies and build scripts removed - this copy is consumed, never rebuilt.",
  "private": true,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons/*": {
      "import": "./dist/icons/*.js",
      "types": "./dist/icons/*.d.ts"
    },
    "./global-nav": {
      "import": "./dist/global-nav.js",
      "types": "./dist/global-nav.d.ts"
    },
    "./styles": "./dist/index.css",
    "./global-nav.css": "./dist/global-nav.css"
  },
  "files": [
    "dist"
  ],
  "license": "UNLICENSED",
  "peerDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@lit/react": "^1.0.7",
    "@mui/material": "^7.0.2",
    "@mui/system": "^7.0.2",
    "@mui/utils": "^7.0.2",
    "@mui/x-data-grid": "^8.24.0",
    "@mui/x-data-grid-pro": "^8.24.0",
    "@mui/x-date-pickers": "^8.24.0",
    "@mui/x-date-pickers-pro": "^8.24.0",
    "@mui/x-license": "^8.24.0",
    "@mui/x-tree-view": "^8.24.0",
    "react": "18 || 19",
    "react-dom": "18 || 19",
    "react-router": "7",
    "lit": "^3.2.1"
  }
}
